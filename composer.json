{
    "name": "momotombo/stdnum-centroamerica",
    "description": "Validación de documentos de identidad y fiscales para Centroamérica",
    "type": "library",
    "keywords": [
        "stdnum",
        "centroamerica",
        "validacion",
        "nit",
        "dui",
        "dpi",
        "cedula",
        "ruc",
        "guatemala",
        "el-salvador",
        "honduras",
        "nicaragua",
        "costa-rica",
        "panama"
    ],
    "homepage": "https://github.com/momotombodevs/stdnum-centroamerica",
    "license": "MIT",
    "support": {
        "issues": "https://github.com/momotombodevs/stdnum-centroamerica/issues",
        "source": "https://github.com/momotombodevs/stdnum-centroamerica"
    },
    "require": {
        "php": ">=8.1",
        "ext-ctype": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0",
        "phpstan/phpstan": "^2.3",
        "friendsofphp/php-cs-fixer": "^3.95"
    },
    "autoload": {
        "psr-4": {
            "StdNumCentroamerica\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "StdNumCentroamerica\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse --no-progress",
        "cs": "php-cs-fixer fix --dry-run --diff",
        "cs:fix": "php-cs-fixer fix",
        "ci": [
            "@cs",
            "@analyse",
            "@test"
        ],
        "coverage": [
            "phpunit --coverage-text --coverage-clover=build/coverage.xml",
            "@coverage:check"
        ],
        "coverage:check": "php tools/check-coverage.php build/coverage.xml 90"
    },
    "config": {
        "sort-packages": true
    }
}
